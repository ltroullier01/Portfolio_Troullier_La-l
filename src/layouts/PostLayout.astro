---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import { site } from '../site.config';

interface Props {
    post: Post;
    prev?: Post;
    next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, author } = post.data;

const dateLabel = pubDate.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const updatedLabel = updatedDate?.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

<BaseLayout
    title={title}
    description={description}
    type="article"
    article={{
        publishedTime: pubDate,
        modifiedTime: updatedDate,
        author: author ?? site.author,
        tags,
    }}
>
    <article data-pagefind-body data-pagefind-filter="type:Projets">
        <header class="border-b-2 border-line bg-paper">
            <div class="mx-auto max-w-[720px] px-6 pt-16 pb-10">
                <a
                    href="/projets"
                    class="inline-flex items-center gap-1 text-sm font-bold text-orange-deep hover:text-orange"
                >
                    ← Retour aux projets
                </a>

                <h1
                    class="mt-4 text-[clamp(2rem,5vw,3rem)] font-bold leading-[1.08] tracking-[-0.02em] text-ink"
                >
                    {title}
                </h1>
                <p class="mt-4 text-lg text-ink/70">{description}</p>

                <div class="mt-6 flex flex-wrap items-center gap-2 text-sm font-semibold text-ink/55">
                    <span>{author ?? site.author}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
                    {
                        updatedLabel && (
                            <>
                                <span aria-hidden="true">·</span>
                                <span>Mis à jour le {updatedLabel}</span>
                            </>
                        )
                    }
                </div>
            </div>
        </header>

        <div class="prose mx-auto max-w-[720px] px-6 py-12">
            <slot />
        </div>
    </article>

    
</BaseLayout>