---
import BaseLayout from './BaseLayout.astro';
import type { Project } from '../lib/projects';

interface Props {
    project: Project;
    next?: Project;
}

const { project, next } = Astro.props;
const { title, description, year } = project.data;
---

<BaseLayout title={title} description={description} type="article">
    <article data-pagefind-body data-pagefind-filter="type:Experiences">
        <header class="border-b-2 border-line bg-paper">
            <div class="mx-auto max-w-[860px] px-6 pt-16 pb-10">
                <a
                    href="/experiences"
                    class="inline-flex items-center gap-1 text-sm font-bold text-orange-deep hover:text-orange"
                >
                    ← Retour aux expériences
                </a>

                {
                    year && (
                        <div class="mt-6 text-[13px] font-bold uppercase tracking-[0.1em] text-orange-deep">
                            <span>{year}</span>
                        </div>
                    )
                }

                <h1 class="text-4xl font-bold !text-neutral-900 md:text-5xl">
                    {project.data.title}
                </h1>
                <p class="mt-4 max-w-[640px] text-lg text-neutral-600">{description}</p>
            </div>
        </header>

        <div class="mx-auto max-w-[860px] px-6 py-12">
            <div class="prose max-w-none prose-headings:!text-neutral-900 prose-p:text-neutral-800">
                <slot />
            </div>
        </div>
    </article>
</BaseLayout>

<style is:global>
    /* Force la justification et la césure propre de tous les paragraphes */
    article .prose p {
        text-align: justify !important;
        text-justify: inter-word;
        hyphens: auto;
    }
</style>