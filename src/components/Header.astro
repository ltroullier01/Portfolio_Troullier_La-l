---
import Logo from './Logo.astro';

const links = [
    { href: '/blog', label: 'Projets' },
    { href: '/work', label: 'Expériences' },
];
---

<nav
    id="site-nav"
    class="sticky top-0 z-50 border-b-[3px] border-orange bg-[#18181b]/95 backdrop-blur-xl transition-shadow duration-250"
>
    <div class="mx-auto flex max-w-[1200px] items-center gap-8 px-8 py-4">
        <Logo />
        <div class="ml-auto flex gap-7 text-[15px] font-semibold">
            {links.map((link) => (
                <a href={link.href} class="text-sky hover:text-orange transition-colors">
                    {link.label}
                </a>
            ))}
        </div>
    </div>
</nav>

<script>
    const nav = document.getElementById('site-nav');
    const onScroll = () => {
        if (!nav) return;
        nav.style.boxShadow = window.scrollY > 8 ? '0 6px 20px rgb(15 30 66 / 0.25)' : 'none';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
</script>