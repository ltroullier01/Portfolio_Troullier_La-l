---
import Logo from './Logo.astro';

const links = [
    { href: '/projets', label: 'Projets' },
    { href: '/experiences', label: 'Expériences' },
];
---

<nav
    id="site-nav"
    class="sticky top-0 z-50 border-b border-orange-500/40 bg-[#111215]/90 backdrop-blur-md transition-all duration-200"
>
    <div class="mx-auto flex max-w-[1200px] items-center gap-8 px-8 py-4">
        <Logo />
        <div class="ml-auto flex gap-8 text-[15px] font-semibold">
            {links.map((link) => (
                <a
                    href={link.href}
                    class="text-neutral-300 transition-colors duration-150 hover:text-orange-500"
                >
                    {link.label}
                </a>
            ))}
        </div>
    </div>
</nav>

<script>
    const nav = document.getElementById('site-nav');
    const onScroll = () => {
        if (!nav) return;
        nav.style.boxShadow = window.scrollY > 8 ? '0 10px 30px -10px rgba(0, 0, 0, 0.5)' : 'none';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
</script>