---
import { Image } from 'astro:assets';
import type { Project } from '../../lib/projects';

interface Props {
    project: Project;
    index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, description, tech = [], year, thumbnail } = project.data;

// Arrière-plans par défaut thème sombre / orange
const themes = [
    'linear-gradient(135deg, #18191e, #252730)',
    'linear-gradient(135deg, #252730, #141518)',
    'linear-gradient(135deg, #1f2026, #2d2620)',
];
const bg = themes[index % themes.length];
const monogram = title.charAt(0).toUpperCase();

const projectUrl = `/experiences/${project.id}`;
---

<article
    class="group relative flex flex-col overflow-hidden rounded-xl border border-neutral-800 bg-[#18191e]/90 backdrop-blur-sm transition-all duration-200 hover:-translate-y-1 hover:border-orange-500/50 hover:shadow-xl hover:shadow-orange-500/5"
>
    <!-- Vignette / Image -->
    <div class="relative aspect-[16/10] overflow-hidden border-b border-neutral-800 bg-neutral-900">
        {
            thumbnail ? (
                <Image
                    src={thumbnail}
                    alt={title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
            ) : (
                <div class="relative flex h-full w-full items-center justify-center" style={`background:${bg}`}>
                    <span class="absolute -right-2 -bottom-6 font-mono text-[8rem] font-bold leading-none text-white/5 select-none">
                        {monogram}
                    </span>
                    <div class="flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 font-mono text-xs font-semibold text-orange-400">
                        <span class="size-1.5 rounded-full bg-orange-500"></span>
                        {monogram}
                    </div>
                </div>
            )
        }
    </div>

    <!-- Contenu texte -->
    <div class="flex flex-1 flex-col p-6">
        <!-- Année seule -->
        {
            year && (
                <div class="text-xs font-bold uppercase tracking-wider text-orange-500">
                    <span>{year}</span>
                </div>
            )
        }

        <!-- Titre -->
        <h3 class="mt-2 text-xl font-bold leading-snug text-white transition-colors group-hover:text-orange-400">
            <a href={projectUrl} class="after:absolute after:inset-0">
                {title}
            </a>
        </h3>

        <!-- Description -->
        <p class="mt-2.5 flex-1 text-sm leading-relaxed text-neutral-400">
            {description}
        </p>

        <!-- Tags / Technologies -->
        {
            tech.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-1.5 pt-2 border-t border-neutral-800/80">
                    {tech.slice(0, 4).map((t) => (
                        <span class="rounded-md border border-neutral-700/60 bg-neutral-800/80 px-2 py-0.5 font-mono text-[11px] font-medium text-neutral-300">
                            {t}
                        </span>
                    ))}
                </div>
            )
        }
    </div>
</article>