---
// Hero — Portfolio
const skills = ['STM32 & Microcontrôleurs', 'C / C++', 'CAN Bus / SPI / I2C', 'LoRaWAN & IoT', 'ROS 2 / Linux', 'MATLAB & Simulink'];
---

<section class="relative bg-gradient-to-b from-[#2a2c35] via-[#22242a] to-[#1c1d22] text-neutral-100 overflow-hidden">
    <header
        id="top"
        class="relative mx-auto grid max-w-[1200px] items-center gap-10 px-8 pt-18 pb-12 lg:grid-cols-[1.1fr_.9fr]"
    >
        <!-- Halos lumineux d'ambiance -->
        <span
            class="pointer-events-none absolute -top-[80px] -right-[60px] z-0 size-[620px] bg-radial from-orange-500/20 via-orange-500/5 to-transparent blur-2xl"
        ></span>
        <span
            class="pointer-events-none absolute -bottom-32 -left-[100px] z-0 size-[500px] bg-radial from-amber-500/15 via-transparent to-transparent blur-2xl"
        ></span>

        <div class="relative z-2">
            <!-- Badge spécialité -->
            <span
                class="inline-flex items-center gap-2 rounded-full border border-orange-500/35 bg-orange-500/15 px-3.5 py-[6px] text-[13px] font-semibold tracking-wide text-orange-400 backdrop-blur-md"
            >
                <span class="size-1.5 rounded-full bg-orange-500"></span>
                Systèmes Embarqués & Électronique
            </span>

            <!-- Nom -->
            <h1
                class="mt-4 text-5xl leading-[1.05] font-bold tracking-tight text-white md:text-[58px]"
            >
                Laël Troullier
            </h1>

            <!-- Sous-titre hiérarchisé -->
            <h2
                class="mt-2 text-2xl font-semibold tracking-tight text-orange-500 md:text-3xl"
            >
                Ingénieur en Génie Électrique
            </h2>

            <p class="mt-5 max-w-[480px] text-[17px] leading-[1.65] text-neutral-300">
                Étudiant en 5ᵉ année à l'INSA Strasbourg. Passionné par l'électronique, la programmation bas niveau, les bus industriels et la robotique.
            </p>

            <!-- Boutons d'action -->
            <div class="mt-8 flex flex-wrap gap-4">
                <a
                    href="/projets"
                    class="rounded-full bg-orange-500 px-6 py-3 font-semibold text-white shadow-lg shadow-orange-500/25 transition-all hover:bg-orange-600 hover:-translate-y-0.5"
                >
                    Voir mes projets →
                </a>
                <a
                    href="/cv.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full border border-neutral-700/80 bg-[#111216] px-6 py-3 font-semibold text-neutral-200 shadow-md shadow-black/40 transition-all hover:border-orange-500/60 hover:bg-[#181920] hover:-translate-y-0.5"
                >
                    Consulter mon CV
                </a>
            </div>

            <!-- Badge statut recherche -->
            <div class="mt-8 flex items-center gap-3 text-sm font-medium text-neutral-300">
                <span class="flex size-2.5 relative">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"></span>
                </span>
                <span>À la recherche d'un PFE (Projet de Fin d'Études) — Février 2027</span>
            </div>
        </div>

        <!-- VISUEL AVEC PHOTO CIRCULAIRE & ANNEAUX ORBITAUX -->
        <div class="relative z-2 mx-auto flex aspect-square w-full max-w-[380px] sm:max-w-[420px] items-center justify-center">
            <!-- Anneau externe en pointillés avec point lumineux orange -->
            <div
                class="absolute h-[86%] w-[86%] rounded-full border border-dashed border-neutral-500/40"
            >
                <span
                    class="absolute -top-[7px] left-1/2 -ml-[7px] size-3.5 rounded-full bg-orange-500 shadow-[0_0_12px_#f97316]"
                ></span>
            </div>

            <!-- Anneau intermédiaire avec petit point repère -->
            <div
                class="absolute h-[66%] w-[66%] rounded-full border border-neutral-500/30"
            >
                <span
                    class="absolute -bottom-[5px] left-1/2 -ml-[5px] size-2.5 rounded-full bg-neutral-300"
                ></span>
            </div>

            <!-- Photo de profil circulaire centrale -->
            <div
                class="group relative z-10 size-44 sm:size-52 overflow-hidden rounded-full border-2 border-orange-500 bg-[#111216] p-1 shadow-2xl shadow-orange-500/20 transition-all duration-300 hover:scale-105 hover:shadow-orange-500/35"
            >
                <img
                    src="/images/image_cv.jpeg"
                    alt="Laël Troullier"
                    class="h-full w-full rounded-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                    loading="eager"
                />
            </div>

            <!-- Repères graphiques subtils -->
            <span class="pointer-events-none absolute top-[10%] right-[12%] font-mono text-sm text-orange-500/60 select-none">01</span>
            <span class="pointer-events-none absolute bottom-[12%] left-[10%] font-mono text-sm text-neutral-400 select-none">&lt;/&gt;</span>
        </div>
    </header>

    <!-- BANDEAU DOMAINES & TECHNOLOGIES -->
    <div class="mx-auto max-w-[1200px] px-8 pb-12">
        <div class="rounded-2xl border border-neutral-800 bg-[#0f1013] p-6 shadow-xl shadow-black/40">
            <p class="mb-4 text-center font-mono text-[11px] font-bold tracking-[0.2em] text-orange-400 uppercase">
                Domaines & Technologies Clés
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
                {
                    skills.map((skill) => (
                        <span class="rounded-lg border border-neutral-800 bg-[#17181f] px-3.5 py-1.5 text-xs font-semibold text-neutral-200 transition-colors hover:border-orange-500/60 hover:text-orange-400">
                            {skill}
                        </span>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- SECTIONS RACCOURCIS : PROJETS & EXPÉRIENCES -->
    <div class="mx-auto max-w-[1200px] px-8 pb-20">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <!-- Carte Projets -->
            <a
                href="/projets"
                class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-neutral-800 bg-[#111216] p-8 shadow-xl shadow-black/30 transition-all duration-200 hover:-translate-y-1 hover:border-orange-500 hover:shadow-[6px_6px_0_0_#f97316]"
            >
                <div class="relative z-10">
                    <span class="font-mono text-xs font-semibold tracking-wider text-orange-400 uppercase"></span>
                    <h3 class="mt-2 text-2xl font-bold text-white transition-colors group-hover:text-orange-400">
                        Projets
                    </h3>
                    <p class="mt-2 text-sm text-neutral-300">
                        Systèmes embarqués, robotique, IoT et réalisations techniques personnelles ou académiques.
                    </p>
                </div>

                <div class="relative z-10 mt-8 flex items-center gap-2 font-semibold text-orange-400">
                    <span>Explorer mes projets</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                </div>

                <span class="pointer-events-none absolute -right-3 -bottom-5 font-mono text-8xl font-black text-white/[0.03] select-none transition-transform duration-300 group-hover:scale-110">
                    PRO
                </span>
            </a>

            <!-- Carte Expériences -->
            <a
                href="/experiences"
                class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-neutral-800 bg-[#111216] p-8 shadow-xl shadow-black/30 transition-all duration-200 hover:-translate-y-1 hover:border-orange-500 hover:shadow-[6px_6px_0_0_#f97316]"
            >
                <div class="relative z-10">
                    <span class="font-mono text-xs font-semibold tracking-wider text-orange-400 uppercase"></span>
                    <h3 class="mt-2 text-2xl font-bold text-white transition-colors group-hover:text-orange-400">
                        Expériences
                    </h3>
                    <p class="mt-2 text-sm text-neutral-300">
                        Stages industriels, déploiements sur site et responsabilités d'ingénierie.
                    </p>
                </div>

                <div class="relative z-10 mt-8 flex items-center gap-2 font-semibold text-orange-400">
                    <span>Voir mon parcours</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                </div>

                <span class="pointer-events-none absolute -right-3 -bottom-5 font-mono text-8xl font-black text-white/[0.03] select-none transition-transform duration-300 group-hover:scale-110">
                    EXP
                </span>
            </a>
        </div>
    </div>
</section>