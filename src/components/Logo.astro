---
interface Props {
    size?: 'md' | 'sm';
    href?: string;
}
const { size = 'md', href = '/' } = Astro.props;
const text = size === 'md' ? 'text-[21px]' : 'text-xl';
---

<a
    href={href}
    class:list={[
        'flex items-center font-display font-bold tracking-tight text-white hover:text-orange transition-colors',
        text,
    ]}
>
    Laël Troullier
</a>