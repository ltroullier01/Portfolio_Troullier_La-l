---
import type { Post } from '../../lib/posts';

interface Props {
    post: Post;
    /** Indice pour alterner l'inclinaison des cartes */
    index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, description, pubDate, image } = post.data;

const dateLabel = pubDate.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
});

// Inclinaison de ±1.5° redressée au survol
const tilt = index % 2 === 0 ? '-rotate-[1.5deg]' : 'rotate-[1.5deg]';
---

<article
    class:list={[
        'group relative flex flex-col rounded-card border-2 border-ink bg-cloud p-6 shadow-[5px_5px_0_0_#f97316] transition-[transform,box-shadow] duration-200 hover:rotate-0 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_#f97316]',
        tilt,
    ]}
>
    <!-- Image de couverture (si présente) -->
    {
        image && (
            <div class="mb-4 aspect-video w-full overflow-hidden rounded-lg border border-ink/15 bg-neutral-900/5">
                <img
                    src={image}
                    alt={title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                />
            </div>
        )
    }

    <h3 class="text-[22px] font-bold leading-tight tracking-[-0.02em] text-ink">
        <a href={`/projets/${post.id}`} class="after:absolute after:inset-0 group-hover:text-navy">
            {title}
        </a>
    </h3>

    <div class="mt-2.5 flex items-center gap-2 text-[13px] font-semibold text-ink/55">
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    </div>

    <p class="mt-3 text-[15px] leading-relaxed text-ink/75">{description}</p>

    <span class="mt-auto pt-4 inline-flex items-center gap-1 text-[15px] font-bold text-orange-deep">
        En savoir plus
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
</article>